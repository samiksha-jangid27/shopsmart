{
  "family": "shopsmart-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::857558323395:role/LabRole",
  "taskRoleArn": "arn:aws:iam::857558323395:role/LabRole",
  "containerDefinitions": [
    {
      "name": "shopsmart-api",
      "image": "IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "4000"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/shopsmart",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "shopsmart"
        }
      }
    }
  ]
}
